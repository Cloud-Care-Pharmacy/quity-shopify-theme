{%- comment -%}
  Stroke icon set for sections/quity-apply-card.liquid.

  Usage: {%- render 'quity-apply-card-icon', icon: 'clock' -%}
         {%- render 'quity-apply-card-icon', icon: 'eye', class: 'qha__eye-on' -%}

  Icons are 24×24 stroke drawings with `fill="none"`; sizing and colour
  come from the .qha- CSS (assets/quity-apply-card.css), which also opts
  them out of the theme's global `svg { fill: currentColor }` rule.
{%- endcomment -%}

<svg{% if class %} class="{{ class }}"{% endif %} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'shield' -%}
      <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path>
      <path d="M9 12l2 2 4-4"></path>
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M8.5 12.5l2.2 2.2 4.8-5"></path>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7.5v5l3 1.8"></path>
    {%- when 'truck' -%}
      <path d="M3 7h11v8H3z"></path>
      <path d="M14 10h4l3 3v2h-7z"></path>
      <circle cx="7" cy="17" r="1.7"></circle>
      <circle cx="17" cy="17" r="1.7"></circle>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.4-7-9.3A3.7 3.7 0 0 1 12 8a3.7 3.7 0 0 1 7 2.7C19 15.6 12 20 12 20z"></path>
    {%- when 'target' -%}
      <circle cx="12" cy="12" r="8.5"></circle>
      <circle cx="12" cy="12" r="4.5"></circle>
      <circle cx="12" cy="12" r="1"></circle>
    {%- when 'star' -%}
      <path d="M12 4l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L4.2 9.7l5.4-.8z"></path>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="9" rx="1.5"></rect>
      <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
    {%- when 'upload' -%}
      <path d="M4 15v3.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V15"></path>
      <path d="M12 15V4"></path>
      <path d="M8 8l4-4 4 4"></path>
    {%- when 'script' -%}
      <path d="M6 3.5h9L19 8v12.5H6z"></path>
      <path d="M14.5 3.5V8H19"></path>
      <path d="M9 12.5h7"></path>
      <path d="M9 16h4.5"></path>
    {%- when 'eye' -%}
      <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    {%- when 'eye_off' -%}
      <path d="M9.9 5.9A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-3 3.9"></path>
      <path d="M6.4 7.6A16.9 16.9 0 0 0 2.5 12S6 18.5 12 18.5a9.3 9.3 0 0 0 3.8-.8"></path>
      <path d="M10 10a2.8 2.8 0 0 0 4 4"></path>
      <path d="M4 4l16 16"></path>
    {%- when 'arrow' -%}
      <path d="M5 12h14"></path>
      <path d="M13 6l6 6-6 6"></path>
    {%- else -%}
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M8.5 12.5l2.2 2.2 4.8-5"></path>
  {%- endcase -%}
</svg>
