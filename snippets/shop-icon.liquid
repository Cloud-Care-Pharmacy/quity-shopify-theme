      <circle cx="18" cy="6" r="2.1"/>
      <circle cx="6" cy="18" r="2.1"/>
      <circle cx="18" cy="18" r="2.1"/>
      <circle cx="12" cy="12" r="2.1"/>
      <path d="m7.5 7.5 3 3M16.5 7.5l-3 3M7.5 16.5l3-3M16.5 16.5l-3-3"/>
    {%- when 'compass' -%}
      <circle cx="12" cy="12" r="8.6"/>
      <path d="M15.9 8.1 14 14l-5.9 1.9L10 10l5.9-1.9Z"/>
    {%- when 'leaf' -%}
      <path d="M4.5 19.5c0-8 5.5-13 15-13 0 9-5 14-11.5 14a6 6 0 0 1-3.5-1Z"/>
