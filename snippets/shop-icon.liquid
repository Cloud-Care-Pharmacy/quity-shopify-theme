    {%- when 'pods' -%}
      <path d="M10.2 13.3a4.6 4.6 0 0 0 6.94.5l2.76-2.76a4.6 4.6 0 0 0-6.5-6.5l-1.58 1.57"/>
      <path d="M13.8 10.7a4.6 4.6 0 0 0-6.94-.5L4.1 12.96a4.6 4.6 0 0 0 6.5 6.5l1.57-1.57"/>
