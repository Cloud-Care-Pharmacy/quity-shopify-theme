      <rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/>
      <rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/>
    {%- when 'nrt' -%}
      <path d="M12 3.2 4.9 6v5.7c0 4.15 2.93 7.65 7.1 8.5 4.17-.85 7.1-4.35 7.1-8.5V6L12 3.2Z"/>
