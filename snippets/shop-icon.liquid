{%- comment -%}
  Quity Shop — line icon set for the qsh- browse tiles.

  Usage: {%- render 'shop-icon', name: 'starter-kit' -%}

  24x24 stroke icons, no fill, sized by the .qsh-icon wrapper in
  assets/shop-collections.css. The names match the icon select
  options in sections/shop-product-types.liquid and
  sections/shop-knowledge.liquid — keep the two lists in step.
{%- endcomment -%}

{%- liquid
  assign icon = name | default: 'box'
-%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'starter-kit' -%}
      <path d="M12 4 4 18.5h16L12 4Z"/>
      <path d="M12 9.5v5.5"/>
      <path d="M9.8 11.7 12 9.5l2.2 2.2"/>
    {%- when 'device' -%}
      <circle cx="12" cy="12" r="3"/>
