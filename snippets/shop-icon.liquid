    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.6"/>
      <path d="M12 7v5.3l3.3 2"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h15"/>
      <path d="m13 6 6 6-6 6"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/>
      <path d="m20 20-3.7-3.7"/>
    {%- else -%}
      <rect x="3.5" y="6.5" width="17" height="12" rx="2"/>
      <path d="M3.5 10.5h17M9.5 6.5v12"/>
  {%- endcase -%}
</svg>
