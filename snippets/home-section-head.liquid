{%- comment -%}
  Quity Home — centred section header: h2 and an optional sub line.
  (No kicker/eyebrow above the heading — the heading carries the topic.)

  Params: title, sub, max (px, default 640).
  Renders nothing when both texts are empty.
{%- endcomment -%}
{%- liquid
  assign head_max = max | default: 640
-%}
{%- if title != blank or sub != blank -%}
  <div class="qhm-head" style="max-width:{{ head_max }}px">
    {%- if title != blank -%}
      <h2 class="qhm-head__title">{{ title | escape }}</h2>
    {%- endif -%}
    {%- if sub != blank -%}
      <p class="qhm-head__sub">{{ sub | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
