{%- comment -%}
  Quity Home — how it works
  -------------------------
  Centred header, four lifting step cards (icon box + "Step 01" badge,
  heading, body) joined by hairline arrows on desktop, and a centred
  "Get started" button. Steps are blocks; the badge numbers itself.
  The section carries the #how anchor the "Learn more" buttons target.

  Design: "Quity Homepage" handoff, section 6 — scoped .qhm- classes in
  assets/home-page.css. Static, no JavaScript.
{%- endcomment -%}

{{ 'home-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cols = section.blocks.size
  if cols > 4
    assign cols = 4
  elsif cols < 1
    assign cols = 1
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .qhm-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ section.id }} .qhm-steps { grid-template-columns: repeat({{ cols }}, 1fr); }
  }
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .qhm-sec {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }
  @media (max-width: 720px) {
    #shopify-section-{{ section.id }} .qhm-sec {
      padding-top: {{ section.settings.padding_top | times: 0.58 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.58 | round }}px;
    }
  }
{%- endstyle -%}

<section class="qhm qhm-sec qhm-sec--{{ section.settings.background }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="qhm__wrap">
    {%- render 'home-section-head',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      sub: section.settings.sub,
      max: 640 -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="qhm-steps" style="list-style:none;margin:52px 0 0;padding:0">
        {%- for block in section.blocks -%}
          <li class="qhm-step" {{ block.shopify_attributes }}>
            <div class="qhm-card qhm-lift qhm-step__card">
              <div class="qhm-step__top">
                <span class="qhm-iconbox">{%- render 'home-icon', name: block.settings.icon, size: 24 -%}</span>
                <span class="qhm-badge qhm-badge--coral">{{ section.settings.step_label | escape }} {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              </div>
              <h4 class="qhm-step__title">{{ block.settings.title | escape }}</h4>
              {%- if block.settings.body != blank -%}
                <p class="qhm-body qhm-step__body">{{ block.settings.body | escape }}</p>
              {%- endif -%}
            </div>
            {%- unless forloop.last -%}
              <span class="qhm-step__arrow" aria-hidden="true">{%- render 'home-icon', name: 'arrow-right', size: 18 -%}</span>
            {%- endunless -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="qhm-steps__cta">
        <a class="qhm-btn qhm-btn--coral qhm-btn--lg" href="{{ section.settings.cta_url | default: '#apply' }}">
          {{ section.settings.cta_label | escape }}
          {%- render 'home-icon', name: 'arrow-right', size: 17 -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home - how it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The process" },
    { "type": "text", "id": "title", "label": "Heading", "default": "How Quity works" },
    { "type": "textarea", "id": "sub", "label": "Sub text", "default": "Four steps from first click to a package at the door. Nothing to pay until a doctor approves your therapy." },
    { "type": "text", "id": "step_label", "label": "Step badge label", "default": "Step" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Get started" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Defaults to the application card (#apply)." },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "In-page links such as “Learn more” point here.", "default": "how" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "paper-2", "label": "Paper (darker)" },
        { "value": "white", "label": "White" }
      ],
      "default": "paper"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "user", "label": "User" },
            { "value": "tablet", "label": "Tablet" },
            { "value": "bell", "label": "Bell" },
            { "value": "truck", "label": "Truck" },
            { "value": "doctor", "label": "Doctor" },
            { "value": "script", "label": "Script" },
            { "value": "chat", "label": "Chat" },
            { "value": "check", "label": "Check" },
            { "value": "clock", "label": "Clock" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "user"
        },
        { "type": "text", "id": "title", "label": "Heading", "default": "Create your account" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Register your patient account. It takes about two minutes." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Home - how it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "user", "title": "Create your account", "body": "Register your patient account. It takes about two minutes." } },
        { "type": "step", "settings": { "icon": "tablet", "title": "Online assessment", "body": "Answer a few questions about your smoking and medical history." } },
        { "type": "step", "settings": { "icon": "bell", "title": "Get notified", "body": "Our medical team reviews your assessment and emails you the outcome." } },
        { "type": "step", "settings": { "icon": "truck", "title": "Express delivery", "body": "Order through the pharmacy portal. Delivered Australia-wide." } }
      ]
    }
  ]
}
{% endschema %}
