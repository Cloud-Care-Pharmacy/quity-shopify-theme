{%- comment -%}
  Quity Shop — search hero
  ------------------------
  Opens the /collections page: eyebrow, headline with the Newsreader
  italic accent word, support line, the store search field and the
  popular-search chips. Chips are blocks; a chip with no link searches
  for its own label.

  Design: the Quity system shared with assets/product-store.css —
  scoped .qsh- classes styled in assets/shop-collections.css. Fonts
  (Jost / JetBrains Mono / Newsreader) are loaded in
  layout/theme.liquid. No JavaScript: the field is a plain GET form
  onto the theme's search results page.
{%- endcomment -%}

{{ 'shop-collections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .qsh-hero__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .qsh-hero__inner {
      padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px;
    }
  }
{%- endstyle -%}

{%- capture hero_title -%}
  {{- section.settings.title_pre | escape -}}
  {%- if section.settings.title_italic != blank %} <span class="qsh-it">{{ section.settings.title_italic | escape }}</span>{% endif -%}
  {%- if section.settings.title_post != blank %} {{ section.settings.title_post | escape }}{% endif -%}
{%- endcapture -%}

<section class="qsh qsh-hero{% if section.settings.band == 'white' %} qsh-hero--plain{% endif %}" data-aos="{{ section.settings.animation }}">
  <div class="qsh-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="qsh-eyebrow">{{ section.settings.eyebrow | escape }}</div>
    {%- endif -%}

    {%- if hero_title != blank -%}
      {%- if section.settings.title_tag == 'h1' -%}
        <h1 class="qsh-hero__title">{{ hero_title }}</h1>
      {%- else -%}
        <h2 class="qsh-hero__title">{{ hero_title }}</h2>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <div class="qsh-hero__sub">{{ section.settings.subtext }}</div>
    {%- endif -%}

    {%- if section.settings.show_search -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="qsh-search">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <label class="visually-hidden" for="qsh-search-{{ section.id }}">
          {{ 'general.search.search' | t }}
        </label>
        <input
          class="qsh-search__input"
          id="qsh-search-{{ section.id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          autocomplete="off">
        <button type="submit" class="qsh-search__submit" aria-label="{{ 'general.search.submit' | t }}">
          {%- render 'shop-icon', name: 'search' -%}
        </button>
      </form>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="qsh-hero__popular">
        {%- if section.settings.popular_label != blank -%}
          <span class="qsh-hero__popular-label">{{ section.settings.popular_label | escape }}</span>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign chip_url = block.settings.link
            if chip_url == blank
              assign chip_term = block.settings.label | url_encode
              assign chip_url = routes.search_url | append: '?type=product&q=' | append: chip_term
            endif
          -%}
          <a class="qsh-chip" href="{{ chip_url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop - hero search",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The catalogue"
    },
    {
      "type": "text",
      "id": "title_pre",
      "label": "Heading (before italic)",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "title_italic",
      "label": "Heading italic word",
      "default": "everything"
    },
    {
      "type": "text",
      "id": "title_post",
      "label": "Heading (after italic)",
      "default": "we stock"
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Heading tag",
      "info": "Use H1 when this is the first heading on the page.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Sub text",
      "default": "<p>Your smokefree journey starts here. Browse by product, by where you are now, or by experience — and talk to our pharmacists whenever you need a hand choosing.</p>"
    },
    {
      "type": "select",
      "id": "band",
      "label": "Background",
      "options": [
        { "value": "warm", "label": "Warm" },
        { "value": "white", "label": "White" }
      ],
      "default": "warm"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search field",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search products..."
    },
    {
      "type": "text",
      "id": "popular_label",
      "label": "Popular search label",
      "default": "Popular search"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 68
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade up" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Popular search",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Solo Plus"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to search for the label."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Shop - hero search",
      "blocks": [
        { "type": "chip", "settings": { "label": "Solo Plus" } },
        { "type": "chip", "settings": { "label": "Starter kits" } },
        { "type": "chip", "settings": { "label": "Pods" } },
        { "type": "chip", "settings": { "label": "E-liquid" } },
        { "type": "chip", "settings": { "label": "NRT" } }
      ]
    }
  ]
}
{% endschema %}
