{%- comment -%}
  Quity Shop — browse by product type
  -----------------------------------
  Compact row of pale tiles, each a circled line icon over a label,
  linking into a collection. Icons come from snippets/shop-icon.liquid.

  Design: Quity "Shop" handoff — scoped .qsh- classes styled in
  assets/shop-collections.css. Static content, no JavaScript.
{%- endcomment -%}

{{ 'shop-collections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .qsh-band {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .qsh-band {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }
  }
{%- endstyle -%}

<section class="qsh qsh-band qsh-types{% if section.settings.band == 'warm' %} qsh-band--warm{% endif %}" data-aos="{{ section.settings.animation }}">
  <div class="qsh__wrap">
    {%- render 'shop-section-head',
      title: section.settings.title,
      link_text: section.settings.link_text,
      link_url: section.settings.link_url -%}

    <div class="qsh-types__grid">
      {%- for block in section.blocks -%}
        <a class="qsh-type" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span class="qsh-icon">{%- render 'shop-icon', name: block.settings.icon -%}</span>
          <span class="qsh-type__label">{{ block.settings.label | escape }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop - product types",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "By product type" },
    { "type": "text", "id": "link_text", "label": "Heading link text", "default": "Shop all products" },
    { "type": "url", "id": "link_url", "label": "Heading link" },
    {
      "type": "select",
      "id": "band",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "warm", "label": "Warm" }
      ],
      "default": "white"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 40 },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade up" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "type",
      "name": "Product type",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "starter-kit", "label": "Starter kit" },
            { "value": "device", "label": "Device" },
            { "value": "pods", "label": "Pods & coils" },
            { "value": "eliquid", "label": "E-liquid" },
            { "value": "accessories", "label": "Accessories" },
            { "value": "nrt", "label": "NRT" },
            { "value": "beginner", "label": "Beginner" },
            { "value": "intermediate", "label": "Intermediate" },
            { "value": "advanced", "label": "Advanced" },
            { "value": "compass", "label": "Compass" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "heart", "label": "Heart" },
            { "value": "clock", "label": "Clock" },
            { "value": "box", "label": "Box" }
          ],
          "default": "box"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Starter Kits" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Shop - product types",
      "blocks": [
        { "type": "type", "settings": { "icon": "starter-kit", "label": "Starter Kits" } },
        { "type": "type", "settings": { "icon": "device", "label": "Vape Devices" } },
        { "type": "type", "settings": { "icon": "pods", "label": "Pods & Coils" } },
        { "type": "type", "settings": { "icon": "eliquid", "label": "E-liquids" } },
        { "type": "type", "settings": { "icon": "accessories", "label": "Accessories" } },
        { "type": "type", "settings": { "icon": "nrt", "label": "NRT" } }
      ]
    }
  ]
}
{% endschema %}
