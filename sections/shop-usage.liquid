{%- comment -%}
  Quity Shop — browse by current usage
  ------------------------------------
  Photo cards that route the shopper by how much they smoke today:
  image, gradient scrim, title with a nudge arrow and a one-line
  qualifier. Each card links into the matching collection.

  Design: Quity "Shop" handoff — scoped .qsh- classes styled in
  assets/shop-collections.css. Static content, no JavaScript.
{%- endcomment -%}

{{ 'shop-collections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .qsh-band {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .qsh-band {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }
  }
{%- endstyle -%}

<section class="qsh qsh-band qsh-usage{% if section.settings.band == 'warm' %} qsh-band--warm{% endif %}" data-aos="{{ section.settings.animation }}">
  <div class="qsh__wrap">
    {%- render 'shop-section-head',
      title: section.settings.title,
      link_text: section.settings.link_text,
      link_url: section.settings.link_url -%}

    <div class="qsh-usage__grid">
      {%- for block in section.blocks -%}
        <a class="qsh-usage__card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <img
              src="{{ block.settings.image | image_url: width: 700 }}"
              srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w"
              sizes="(max-width: 749px) 45vw, 300px"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              alt="{{ block.settings.image.alt | default: block.settings.title | escape }}">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="qsh-usage__body">
            <span class="qsh-usage__row">
              <span class="qsh-usage__title">{{ block.settings.title | escape }}</span>
              <svg class="qsh-usage__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>
              </svg>
            </span>
            {%- if block.settings.description != blank -%}
              <span class="qsh-usage__desc">{{ block.settings.description | escape }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop - current usage",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "By current usage" },
    { "type": "text", "id": "link_text", "label": "Heading link text", "default": "Shop all products" },
    { "type": "url", "id": "link_url", "label": "Heading link" },
    {
      "type": "select",
      "id": "band",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "warm", "label": "Warm" }
      ],
      "default": "warm"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 40 },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade up" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Usage level",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "High Dependency" },
        { "type": "text", "id": "description", "label": "Description", "default": "Smoking more than 20 cigarettes a day" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop - current usage",
      "blocks": [
        { "type": "card", "settings": { "title": "High Dependency", "description": "Vaping heavily or smoking more than 20 cigarettes a day" } },
        { "type": "card", "settings": { "title": "More Dependent", "description": "Smoking 10 or more cigarettes per day" } },
        { "type": "card", "settings": { "title": "Less Dependent", "description": "Smoking less than 10 cigarettes per day" } },
        { "type": "card", "settings": { "title": "Starter Kits", "description": "All-in-one kits with everything you need to get started" } }
      ]
    }
  ]
}
{% endschema %}
