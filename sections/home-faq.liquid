{%- comment -%}
  Quity Home — FAQ
  ----------------
  Header row (heading and intro on the left; "View all" on the
  right) above a two-column accordion. Questions are blocks, split
  first half / second half across the columns (rows rendered by
  snippets/home-faq-item.liquid). One question is open at
  a time page-wide; clicking the open one closes it. Buttons carry
  aria-expanded / aria-controls; behaviour in assets/home-page.js.

  Design: "Quity Homepage" handoff, section 12 — scoped .qhm- classes in
  assets/home-page.css.
{%- endcomment -%}

{{ 'home-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-page.js' | asset_url }}" defer></script>

{%- liquid
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .qhm-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .qhm-sec {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }
  @media (max-width: 720px) {
    #shopify-section-{{ section.id }} .qhm-sec {
      padding-top: {{ section.settings.padding_top | times: 0.58 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.58 | round }}px;
    }
  }
{%- endstyle -%}

<section class="qhm qhm-sec qhm-sec--{{ section.settings.background }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="qhm__wrap">
    <div class="qhm-faq__head">
      <div>
        {%- if section.settings.title != blank -%}
          <h2 class="qhm-faq__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="qhm-body qhm-faq__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a class="qhm-btn qhm-btn--line" href="{{ section.settings.view_all_url | default: '/pages/faqs' }}">{{ section.settings.view_all_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="qhm-faq__grid" data-qhm-faq>
        <div class="qhm-faq__col">
          {%- for block in section.blocks limit: half -%}
            {%- render 'home-faq-item', block: block, open: forloop.first, open_first: section.settings.open_first -%}
          {%- endfor -%}
        </div>
        <div class="qhm-faq__col">
          {%- for block in section.blocks offset: half -%}
            {%- render 'home-faq-item', block: block, open: false, open_first: section.settings.open_first -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home - FAQ",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "What the service covers, how approval works, what things cost, and how quickly your order arrives." },
    { "type": "text", "id": "view_all_label", "label": "View all button", "default": "View all" },
    { "type": "url", "id": "view_all_url", "label": "View all link", "info": "Defaults to /pages/faqs." },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question on load", "default": true },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "paper-2", "label": "Paper (darker)" },
        { "value": "white", "label": "White" }
      ],
      "default": "paper"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What does the assessment involve?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>A short online questionnaire about your smoking or vaping, your general health and any medicines you take. It takes about five minutes and costs nothing.</p>" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Home - FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "What does the assessment involve?", "answer": "<p>A short online questionnaire about your smoking or vaping, your general health and any medicines you take. It takes about five minutes and costs nothing. A registered Australian doctor then reviews your answers and emails you the outcome, usually within 24 hours.</p>" } },
        { "type": "question", "settings": { "question": "Do I need to see a doctor in person?", "answer": "<p>No. The whole process is online. You complete the questionnaire in your own time, the doctor reviews it remotely, and any follow-up happens by phone or video.</p>" } },
        { "type": "question", "settings": { "question": "Who decides whether nicotine therapy is right for me?", "answer": "<p>An AHPRA-registered Australian doctor. They weigh your smoking and medical history against TGA prescribing guidelines before writing anything.</p>" } },
        { "type": "question", "settings": { "question": "What happens if the doctor says no?", "answer": "<p>You pay nothing. If nicotine therapy is not appropriate for you, the doctor will explain why and point you towards other options.</p>" } },
        { "type": "question", "settings": { "question": "Can I use an e-script from another doctor?", "answer": "<p>Yes. Upload it through your account. A QR code or a token number both work. Our pharmacist checks the script, then dispenses and posts your order from the partner pharmacy.</p>" } },
        { "type": "question", "settings": { "question": "How soon will my order arrive?", "answer": "<p>Most assessments come back within 24 hours. Approved orders leave the pharmacy the same business day, and express post reaches most of Australia the following day.</p>" } },
        { "type": "question", "settings": { "question": "How much does the therapy cost?", "answer": "<p>Most patients spend between $25 and $60 a week, depending on the plan. There is no consultation fee and no subscription.</p>" } },
        { "type": "question", "settings": { "question": "Is shipping free?", "answer": "<p>Yes, on orders over $150. Under that, standard post is a flat rate and express is offered at checkout. Every parcel goes out in plain packaging.</p>" } },
        { "type": "question", "settings": { "question": "How long does my script last?", "answer": "<p>Twelve months. It stays on your account, so repeat orders take a minute and ship the same business day.</p>" } },
        { "type": "question", "settings": { "question": "Can I return an order?", "answer": "<p>Australian law does not allow prescription medicines to be returned once dispensed. If something arrives damaged or wrong, contact support and we will replace it.</p>" } },
        { "type": "question", "settings": { "question": "I vape rather than smoke. Can I still apply?", "answer": "<p>Yes. Nicotine dependence is treated the same whether it comes from cigarettes or vapes. Tell the doctor what you use and how often.</p>" } }
      ]
    }
  ]
}
{% endschema %}
