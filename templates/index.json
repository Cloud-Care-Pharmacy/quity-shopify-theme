    "home-faq": {
      "type": "home-faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "question": "What does the assessment involve?",
            "answer": "<p>A short online questionnaire about your smoking or vaping, your general health and any medicines you take. It takes about five minutes and costs nothing. A registered Australian doctor then reviews your answers and emails you the outcome, usually within 24 hours.</p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "question": "Do I need to see a doctor in person?",
            "answer": "<p>No. The whole process is online. You complete the questionnaire in your own time, the doctor reviews it remotely, and any follow-up happens by phone or video.</p>"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "question": "Who decides whether nicotine therapy is right for me?",
            "answer": "<p>An AHPRA-registered Australian doctor. They weigh your smoking and medical history against TGA prescribing guidelines before writing anything.</p>"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "question": "What happens if the doctor says no?",
            "answer": "<p>You pay nothing. If nicotine therapy is not appropriate for you, the doctor will explain why and point you towards other options.</p>"
          }
        },
        "question-5": {
          "type": "question",
          "settings": {
            "question": "Can I use an e-script from another doctor?",
            "answer": "<p>Yes. Upload it through your account. A QR code or a token number both work. Our pharmacist checks the script, then dispenses and posts your order from the partner pharmacy.</p>"
          }
        },
        "question-6": {
          "type": "question",
          "settings": {
            "question": "How soon will my order arrive?",
            "answer": "<p>Most assessments come back within 24 hours. Approved orders leave the pharmacy the same business day, and express post reaches most of Australia the following day.</p>"
          }
        },
        "question-7": {
          "type": "question",
          "settings": {
            "question": "How much does the therapy cost?",
            "answer": "<p>Most patients spend between $25 and $60 a week, depending on the plan. There is no consultation fee and no subscription.</p>"
          }
        },
        "question-8": {
          "type": "question",
          "settings": {
            "question": "Is shipping free?",
            "answer": "<p>Yes, on orders over $150. Under that, standard post is a flat rate and express is offered at checkout. Every parcel goes out in plain packaging.</p>"
          }
        },
        "question-9": {
          "type": "question",
          "settings": {
            "question": "How long does my script last?",
            "answer": "<p>Twelve months. It stays on your account, so repeat orders take a minute and ship the same business day.</p>"
          }
        },
        "question-10": {
          "type": "question",
          "settings": {
            "question": "Can I return an order?",
            "answer": "<p>Australian law does not allow prescription medicines to be returned once dispensed. If something arrives damaged or wrong, contact support and we will replace it.</p>"
          }
        },
        "question-11": {
          "type": "question",
          "settings": {
            "question": "I vape rather than smoke. Can I still apply?",
            "answer": "<p>Yes. Nicotine dependence is treated the same whether it comes from cigarettes or vapes. Tell the doctor what you use and how often.</p>"
          }
        }
      },
